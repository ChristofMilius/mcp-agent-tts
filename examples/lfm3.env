# Copy to <checkout>/.env to make LFM3 the default backend.
# Forward slashes are safest on Windows. Relative paths resolve against the
# checkout root; absolute paths are used here because model files live elsewhere.
MCP_TTS_BACKEND=lfm3
MCP_TTS_VOICE=female
MCP_TTS_LFM3_MODEL=<absolute path to LFM3 GGUF>
MCP_TTS_LFM3_MMPROJ=<absolute path to LFM3 mmproj GGUF>
MCP_TTS_LFM3_EXECUTABLE=<absolute path to llama-server>
MCP_TTS_LFM3_SERVER_PORT=9933
MCP_TTS_LFM3_LANGUAGE=en
MCP_TTS_LFM3_NGL=99
MCP_TTS_LFM3_CTX=4096
